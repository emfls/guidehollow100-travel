---
import CoupangBanner from '../../components/CoupangBanner.astro';
import Layout from '../../layouts/Layout.astro';
import site from '../../site.json';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){
 const s=(await import('../../site.json')).default;
 const posts=await getCollection('guides',({data})=>s.launchReady&&!data.draft&&data.reviewed&&data.language==='ko'&&data.sources.length>0);
 return posts.map(p=>({params:{slug:p.id},props:{post:p}}));
}
const {post}=Astro.props;
const {Content}=await render(post);
---
<Layout title={post.data.title+' | GuideHollow'} description={post.data.description}><article class="wrap content"><a href="/guides/">가이드 목록</a><p class="eyebrow">{site.section} / {post.data.category}</p><h1>{post.data.title}</h1><p>{post.data.description}</p><Content/>
<CoupangBanner placement="article"/><h2>공식 참고 자료</h2><ul class="ref-list">{post.data.sources.map(url=><li><a href={url} target="_blank" rel="noopener noreferrer">{url}</a></li>)}</ul></article></Layout>